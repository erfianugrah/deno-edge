# Copy to .env and edit. Container env (read by functions + Caddy {$FN_ZONE}).

# Base zone for app subdomains: apps become <name>.${FN_ZONE}
FN_ZONE=fn.example.com

# Where this repo lives on the Docker host. "." works for plain `docker compose up`.
# Set an absolute path if your orchestrator runs compose from a different cwd
# (e.g. a docker-in-docker manager — relative paths won't resolve there).
STACK_DIR=.

# Host bind for the internal HTTP port your TLS-terminating proxy points at.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# Optional HS256 JWT gate on functions (enforced in functions/main/index.ts).
VERIFY_JWT=false
JWT_SECRET=

# Per-invocation user-isolate limits.
WORKER_MEMORY_MB=150
WORKER_TIMEOUT_MS=60000
